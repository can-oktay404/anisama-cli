def check_deps():
    missing = []
    optional_missing = []

    def check_cmd(cmd, name, optional=False):
        try:
            subprocess.run([cmd, "--version"], capture_output=True, timeout=3)
            return True
        except (subprocess.TimeoutExpired, FileNotFoundError):
            (optional_missing if optional else missing).append(name)
            return False

    check_cmd("fzf", "fzf")
    check_cmd("mpv", "mpv")
    check_cmd("yt-dlp", "yt-dlp", optional=True)

    try:
        import requests  # noqa: F401
    except ImportError:
        missing.append("python3-requests")

    try:
        import bs4  # noqa: F401
    except ImportError:
        missing.append("python3-bs4")

    if missing:
        print(f"{RED}✗ Dépendances manquantes : {', '.join(missing)}{RESET}")
        print(f"{YELLOW}  sudo apt install {' '.join(missing)}{RESET}")
        sys.exit(1)

    if optional_missing:
        print(f"{YELLOW}  ⚠ Optionnel manquant : {', '.join(optional_missing)}{RESET}")
        print()


def fzf_select(items, prompt="Sélection : ", multi=False):
    if not items:
        return None
    if len(items) == 1:
        return items[0]
    cmd = ["fzf", "--reverse", "--cycle", f"--prompt={prompt}"]
    if multi:
        cmd.append("-m")
    try:
        result = subprocess.run(cmd, input="\n".join(items), text=True, capture_output=True)
        if result.returncode == 0:
            selected = result.stdout.strip()
            return selected.split('\n') if multi else selected
        return None
    except FileNotFoundError:
        print(f"{RED}✗ fzf introuvable — sudo apt install fzf{RESET}")
        return None
    except Exception as e:
        print(f"{RED}✗ Erreur de sélection : {e}{RESET}")
        return None



                print(f"  {RED}✗ pas de saison{RESET}")
                continue
            season_url = urls[0].rstrip('/') + '/' + seasons[0]['url'].lstrip('/')
            filever = get_episode_list(season_url)
            if filever:
                episodes = downloader.get_anime_episode(season_url, filever)
                if episodes:
                    srv = list(episodes.values())[0][0]
                    if srv == 'sibnet':
                        print(f"  {GREEN}✓ {name} : Sibnet (fonctionne){RESET}")
                    elif srv == 'vidmoly':
                        print(f"  {YELLOW}⚠ {name} : Vidmoly (VPN requis){RESET}")
                    else:
                        print(f"  {BLUE}? {name} : service inconnu{RESET}")
                else:
                    print(f"  {RED}✗ pas d'épisodes{RESET}")
            else:
                print(f"  {RED}✗ liste épisodes inaccessible{RESET}")
        except Exception as e:
            print(f"  {RED}✗ erreur : {e}{RESET}")
    print(f"\n  {BLUE}💡 --vf pour les doublages français{RESET}\n")


def get_mpv_args(video_url):
    base = ['mpv', video_url, '--fullscreen',
            f'--user-agent={HEADERS_BASE["user-agent"]}']
    if 'vidmoly' in video_url.lower() or '.m3u8' in video_url:
        base.append('--referrer=https://vidmoly.net/')
    return base


# ── Historique ────────────────────────────────────────────────────────────────

def display_history():
    init_db()
    entries = get_history_entries()
    if not entries:
        die("Aucun historique trouvé")

    display_items = [
        f"{i+1}. {e[1]} — {e[2]} — {e[3]}"
        for i, e in enumerate(entries)
    ]

    print(f"  {MAGENTA}📚 Historique{RESET}")
    selected = fzf_select(display_items, "  Historique › ")
    if not selected:
        return

    try:
        index = int(selected.split('.')[0]) - 1
        if index < 0 or index >= len(entries):
            die("Sélection invalide")
    except (ValueError, IndexError):
        die("Sélection invalide")

    _, anime_name, episode, saison, url = entries[index]

    match = re.search(r'(\d+)$', episode)
    if not match:
        die("Numéro d'épisode introuvable dans l'historique")
    current_ep = int(match.group(1))

    filever = get_episode_list(url)
    if not filever:
        die("Impossible de récupérer la liste des épisodes")

    downloader = AnimeDownloader()
    episodes = downloader.get_anime_episode(url, filever)
    if not episodes:
        die("Aucun épisode trouvé")

    ep_keys = sorted(episodes.keys(), key=lambda k: int(k) if k.isdigit() else 0)
    current_index = None
    for i, k in enumerate(ep_keys):
        if k.isdigit() and int(k) > current_ep:
            current_index = i
            break

    if current_index is None:
        print(f"  {GREEN}✓{RESET} Déjà au dernier épisode de {BOLD}{anime_name}{RESET} — {saison}")
        return

    try:
        while True:
            ep_key = ep_keys[current_index]
            vdata = episodes[ep_key]
            ep_label = vdata[2] if len(vdata) >= 3 else f"Épisode {ep_key}"

            print(f"\n  {CYAN}▶{RESET} {BOLD}{ep_label}{RESET}  {WHITE}({anime_name}){RESET}")
            vurl = downloader.get_video_url(vdata)
            if not vurl:
                die("URL vidéo introuvable")
            if vurl.startswith('//'):
                vurl = 'https:' + vurl

            subprocess.run(get_mpv_args(vurl), check=True, timeout=PLAYBACK_TIMEOUT)
            add_to_history(anime_name=anime_name, episode=f"Episode {ep_key}", saison=saison, url=url)

            if current_index < len(ep_keys) - 1:
                next_key = ep_keys[current_index + 1]
                next_label = episodes[next_key][2] if len(episodes[next_key]) >= 3 else f"Épisode {next_key}"
                try:
                    ans = input(f"\n  {YELLOW}Suivant{RESET} › {next_label} ? [{GREEN}O{RESET}/n] ").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    print()
                    break
                if ans in ('', 'o', 'y', 'oui', 'yes'):
                    current_index += 1
                else:
                    break
            else:
                print(f"  {GREEN}✓{RESET} Dernier épisode atteint")
                break

    except FileNotFoundError:
        die("mpv n'est pas installé")
    except subprocess.CalledProcessError as e:
        if 'vidmoly' in str(e):
            print(f"{RED}✗ Vidmoly inaccessible — essayez un VPN ou --vf{RESET}")
        die("Erreur de lecture")
    except Exception as e:
        die(f"Erreur inattendue : {e}")


# ── Point d'entrée principal ──────────────────────────────────────────────────

def main():
    show_banner()
    check_deps()

    parser = argparse.ArgumentParser(description="anisama-cli", add_help=False)
    parser.add_argument("query", nargs="*")
    parser.add_argument("-c", "--continue", action="store_true", dest="continuer")
    parser.add_argument("--vf", action="store_true")
    parser.add_argument("--debug", action="store_true")
    parser.add_argument("--check-services", action="store_true")
    parser.add_argument("--available-only", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    args = parser.parse_args()

    if args.help:
        print(f"""
  {BOLD}{WHITE}ANISAMA-CLI{RESET} {CYAN}v{__version__}{RESET}

  {BOLD}Usage :{RESET}
    anisama-cli [OPTIONS] [RECHERCHE]

  {BOLD}Options :{RESET}
    {YELLOW}-c, --continue{RESET}       Reprendre depuis l'historique
    {YELLOW}--vf{RESET}                 Rechercher en VF (doublage français)
    {YELLOW}--debug{RESET}              Mode debug
    {YELLOW}--check-services{RESET}     Afficher quel service utilise chaque anime
    {YELLOW}--available-only{RESET}     Afficher uniquement les animes sans VPN (Sibnet)
    {YELLOW}-h, --help{RESET}           Afficher cette aide

  {BOLD}Exemples :{RESET}
    anisama-cli                    # Recherche interactive
    anisama-cli naruto             # Rechercher "naruto"
    anisama-cli -c                 # Historique
    anisama-cli --vf one piece     # One Piece en VF
        """)
        return

    if args.continuer:
        display_history()
        return

    if args.check_services:
        check_anime_services()
        return

    if args.available_only:
        show_available_animes()
        return

    query = " ".join(args.query) if args.query else search_prompt()

    print()
    print(f"{BOLD}{CYAN}╭─ 🔍 Recherche sur anime-sama.to{RESET}")
    print(f"{CYAN}╰─➤{RESET} {YELLOW}\"{query}\"{RESET}")

    if any(a in query.lower() for a in ['naruto', 'sasuke', 'boruto']) and not args.vf:
        print(f"  {YELLOW}⚠ VOSTFR utilise Vidmoly (peut être bloqué) — essayez --vf{RESET}")

    try:
        downloader = AnimeDownloader(debug=args.debug)
        animes, urls = downloader.get_catalogue(query, vf=args.vf)
    except requests.exceptions.ConnectionError:
        show_error('network', 'Connexion à anime-sama.to impossible')
        die("Erreur réseau")
    except requests.exceptions.Timeout:
        show_error('network', 'Timeout')
        die("Timeout connexion")
    except Exception as e:
        if args.debug:
            print(f"{RED}[DEBUG] {e}{RESET}")
        show_error('network')
        die("Impossible de récupérer le catalogue")

    if not animes:
        show_error('no_results', f'Requête : "{query}"')
        die("Aucun résultat")

    print()
    print(f"{BOLD}{CYAN}╭─ 📋 {len(animes)} résultat(s) pour \"{query}\"{RESET}")
    print()

    display_items = [f"{i+1}. {a}" for i, a in enumerate(animes)]
    selected_anime_str = fzf_select(display_items, "  Anime › ")
    if not selected_anime_str:
        die("Aucun anime sélectionné")

    try:
        idx = int(selected_anime_str.split('.')[0]) - 1
        if idx < 0 or idx >= len(animes):
            die("Sélection invalide")
    except (ValueError, IndexError):
        die("Sélection invalide")

    anime_name = animes[idx]
    anime_url = urls[idx]
    print(f"  {GREEN}✓{RESET} {BOLD}{anime_name}{RESET}")

    response = requests.get(anime_url, headers=HEADERS_BASE)
    seasons = get_seasons(response.text)
    if not seasons:
        die("Aucune saison trouvée")

    season_items = [f"{i+1}. {s['name']}" for i, s in enumerate(seasons)]
    selected_season_str = fzf_select(season_items, "  Saison › ")
    if not selected_season_str:
        die("Aucune saison sélectionnée")

    try:
        si = int(selected_season_str.split('.')[0]) - 1
        if si < 0 or si >= len(seasons):
            die("Sélection invalide")
    except (ValueError, IndexError):
        die("Sélection invalide")

    selected_season = seasons[si]
    season_url = anime_url.rstrip('/') + '/' + selected_season['url'].lstrip('/')
    if args.vf:
        season_url = season_url.replace("vostfr", "vf")

    if args.debug:
        print(f"[DEBUG] Season URL : {season_url}")

    filever = get_episode_list(season_url)
    if not filever:
        die("Impossible de récupérer la liste des épisodes")

    episodes = downloader.get_anime_episode(season_url, filever)
    if not episodes:
        die("Aucun épisode trouvé")

    ep_keys = list(episodes.keys())
    ep_items = []
    for i, k in enumerate(ep_keys):
        name = episodes[k][2] if len(episodes[k]) >= 3 else f"Épisode {k}"
        ep_items.append(f"{i+1}. {name}")

    selected_episode_str = fzf_select(ep_items, "  Épisode › ")
    if not selected_episode_str:
        die("Aucun épisode sélectionné")

    try:
        ei = int(selected_episode_str.split('.')[0]) - 1
        if ei < 0 or ei >= len(ep_keys):
            die("Sélection invalide")
    except (ValueError, IndexError):
        die("Sélection invalide")

    # Calcul du label de saison pour l'historique
    def saison_label():
        label = selected_season['name']
        if "saison" not in label.lower():
            m = re.search(r'/saison(\d+)', season_url, re.IGNORECASE)
            label = f"Saison {m.group(1)}" if m else label
        version = "VOSTFR" if "vostfr" in season_url.lower() else ("VF" if re.search(r'/vf/?', season_url.lower()) else "")
        if version and version.lower() not in label.lower():
            label = f"{label} - {version}"
        return label

    current_index = ei

    try:
        while True:
            ep_key = ep_keys[current_index]
            vdata = episodes[ep_key]
            ep_label = vdata[2] if len(vdata) >= 3 else f"Épisode {ep_key}"

            print(f"\n  {CYAN}▶{RESET} {BOLD}{ep_label}{RESET}")
            vurl = downloader.get_video_url(vdata)
            if not vurl:
                die("URL vidéo introuvable")
            if vurl.startswith('//'):
                vurl = 'https:' + vurl

            subprocess.run(get_mpv_args(vurl), check=True, timeout=PLAYBACK_TIMEOUT)
            add_to_history(anime_name=anime_name, episode=f"Episode {ep_key}", saison=saison_label(), url=season_url)

            if current_index < len(ep_keys) - 1:
                next_key = ep_keys[current_index + 1]
                next_label = episodes[next_key][2] if len(episodes[next_key]) >= 3 else f"Épisode {next_key}"
                try:
                    ans = input(f"\n  {YELLOW}Suivant{RESET} › {next_label} ? [{GREEN}O{RESET}/n] ").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    print()
                    break
                if ans in ('', 'o', 'y', 'oui', 'yes'):
                    current_index += 1
                else:
                    break
            else:
                print(f"  {GREEN}✓{RESET} Dernier épisode atteint")
                break

    except FileNotFoundError:
        die("mpv n'est pas installé")
    except subprocess.CalledProcessError as e:
        if 'vidmoly' in str(getattr(e, 'cmd', '')):
            print(f"{RED}✗ Vidmoly inaccessible — essayez un VPN ou --vf{RESET}")
        else:
            show_error('playback', f'Code : {e.returncode}')
        die("Erreur de lecture")
    except Exception as e:
        show_error('playback')
        die(f"Erreur inattendue : {e}")

    print(f"\n  {GREEN}✓{RESET} Terminé — {YELLOW}-c{RESET} pour reprendre")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Annulé{RESET}")

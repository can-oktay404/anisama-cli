def get_seasons(html_content):
    seasons = []
    for name, path in PANNEAU_PATTERN.findall(html_content):
        if "film" not in name.lower() and name.lower() != "nom":
            seasons.append({'name': name, 'url': path})
    return seasons


def get_episode_list(url):
    url = url.replace('https://', '')
    headers = {
        "host": "anime-sama.to",
        "user-agent": HEADERS_BASE["user-agent"],
        "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "accept-language": "fr-FR,fr;q=0.9",
        "connection": "keep-alive",
    }
    try:
        response = requests.get(f"https://{url}", headers=headers, timeout=REQUEST_TIMEOUT)
        match = EPISODE_FILEVER_PATTERN.search(response.text)
        return match.group(1) if match else None
    except Exception as e:
        print(f"{RED}✗ Erreur récupération épisodes : {e}{RESET}")
        return None


# ── Classe principale ─────────────────────────────────────────────────────────

class AnimeDownloader:
    SCRIPT_PATTERN = re.compile(r'creerListe\((\d+),\s*(\d+)\);\s*newSPF?\(["\']([^"\']+)["\']\);?')
    CREER_PATTERN = re.compile(r'creerListe\((\d+),\s*(\d+)\);')
    FINIR_PATTERN = re.compile(r'finirListeOP?\((\d+)\);')
    TAILLE_PATTERN = re.compile(r'var\s+tailleEpisodes\s*=\s*(\d+)')
    RETARDS_PATTERN = re.compile(r'var\s+epRetards\s*=\s*(\d+)')

    def __init__(self, debug=False):
        self.session = requests.Session()
        self.session.headers.update(HEADERS_BASE)
        self.debug = debug
        self._cache = OrderedDict()

    def debug_print(self, *args, **kwargs):
        if self.debug:
            print("[DEBUG]", *args, **kwargs)

    def _cached_request(self, method, url, **kwargs):
        key = url + str(sorted(kwargs.get('params', {}).items()))
        if key in self._cache:
            cached, ts = self._cache[key]
            if time.time() - ts < CACHE_TTL:
                self.debug_print(f"Cache hit : {url[:60]}")
                return cached
        for attempt in range(MAX_RETRIES):
            try:
                resp = getattr(self.session, method)(url, timeout=REQUEST_TIMEOUT, **kwargs)
                resp.raise_for_status()
                self._cache[key] = (resp, time.time())
                self._cache.move_to_end(key)
                if len(self._cache) > MAX_CACHE_SIZE:
                    self._cache.popitem(last=False)
                return resp
            except requests.exceptions.Timeout:
                if attempt < MAX_RETRIES - 1:
                    self.debug_print(f"Timeout tentative {attempt + 1}, retry...")
                    time.sleep(1)
                    continue
                raise
            except requests.exceptions.RequestException as e:
                if attempt < MAX_RETRIES - 1 and "Connection" in str(e):
                    self.debug_print(f"Erreur connexion tentative {attempt + 1}, retry...")
                    time.sleep(2)
                    continue
                raise

    # ── Extraction liste épisodes depuis le JavaScript ────────────────────────

    def _extract_episodes_from_javascript(self, content):
        episode_list = []
        try:
            special_matches = self.SCRIPT_PATTERN.findall(content)
            regular_matches = self.CREER_PATTERN.findall(content)
            finir_match = self.FINIR_PATTERN.search(content)

            self.debug_print(f"Blocs spéciaux : {len(special_matches)}, réguliers : {len(regular_matches)}")

            if not special_matches and not regular_matches:
                return []

            covered = set()
            for start_ep, end_ep, special_name in special_matches:
                start, end = int(start_ep), int(end_ep)
                for n in range(start, end + 1):
                    episode_list.append(f"Épisode {n}")
                    covered.add(n)
                episode_list.append(special_name)

            for start_ep, end_ep in regular_matches:
                start, end = int(start_ep), int(end_ep)
                if start not in covered:
                    for n in range(start, end + 1):
                        episode_list.append(f"Épisode {n}")

            if finir_match:
                start_finir = int(finir_match.group(1))
                end_finir = None
                taille = self.TAILLE_PATTERN.search(content)
                if taille:
                    total = int(taille.group(1))
                    retards = int(self.RETARDS_PATTERN.search(content).group(1)) if self.RETARDS_PATTERN.search(content) else 0
                    end_finir = total - retards
                if not end_finir:
                    existing_nums = [int(e.split()[-1]) for e in episode_list if e.startswith("Épisode ") and e.split()[-1].isdigit()]
                    end_finir = max(existing_nums) + 5 if existing_nums else start_finir + 50
                for n in range(start_finir, end_finir + 1):
                    episode_list.append(f"Épisode {n}")
                self.debug_print(f"finirListe : {start_finir}–{end_finir}")

            return episode_list
        except Exception as e:
            self.debug_print(f"Erreur parsing JS épisodes : {e}")
            return []

    def _extract_episodes_from_selector(self, content):
        try:
            ep_list = self._extract_episodes_from_javascript(content)
            if ep_list:
                self.debug_print(f"{len(ep_list)} épisodes depuis JS")
                return ep_list

            soup = BeautifulSoup(content, 'html.parser')
            sel = soup.find('select', {'id': 'selectEpisodes'})
            if not sel:
                sel = soup.find('select', class_=lambda x: x and 'episode' in x.lower())
            if sel:
                ep_list = [o.get_text(strip=True) for o in sel.find_all('option') if o.get_text(strip=True)]
                self.debug_print(f"{len(ep_list)} épisodes depuis sélecteur HTML")
                return ep_list

            # Fallback regex
            m = re.search(r'<select[^>]*id=["\']selectEpisodes["\'][^>]*>(.*?)</select>', content, re.DOTALL | re.IGNORECASE)
            if m:
                ep_list = [t.strip() for t in re.findall(r'<option[^>]*>([^<]+)</option>', m.group(1), re.IGNORECASE) if t.strip()]
                self.debug_print(f"{len(ep_list)} épisodes depuis regex HTML")
                return ep_list

            return []
        except Exception as e:
            self.debug_print(f"Erreur extraction épisodes : {e}")
            return []

    # ── Récupération épisodes (liens vidéo) ───────────────────────────────────

    def get_anime_episode(self, complete_url, filever):
        complete_url = complete_url.replace('https://', '')
        js_url = f"https://{complete_url}/episodes.js"
        all_links = {}
        try:
            # Noms d'épisodes depuis la page principale
            ep_names = []
            try:
                main_resp = self._cached_request('get', f"https://{complete_url}")
                if main_resp.status_code == 200:
                    ep_names = self._extract_episodes_from_selector(main_resp.text)
                    self.debug_print(f"{len(ep_names)} noms d'épisodes trouvés")
            except Exception as e:
                self.debug_print(f"Page principale inaccessible : {e}")

            # Liens vidéo depuis episodes.js
            response = self._cached_request('get', js_url, params={"filever": filever})
            content = response.text

            array_pattern = r'var eps(\d+) = \[(.*?)\];'
            arrays = re.findall(array_pattern, content, re.DOTALL)

            if arrays:
                best_sibnet = []
                best_vidmoly = []
                for _, array_content in arrays:
                    sibnet = [(m.group(1), 'sibnet') for m in re.finditer(r'https://video\.sibnet\.ru/shell\.php\?videoid=(\d+)', array_content)]
                    if len(sibnet) > len(best_sibnet):
                        best_sibnet = sibnet
                    vidmoly = [(m.group(1), 'vidmoly') for m in re.finditer(r'https://vidmoly\.to/embed-([^.]+)\.html', array_content)]
                    if len(vidmoly) > len(best_vidmoly):
                        best_vidmoly = vidmoly

                # Préférer Sibnet sauf si Vidmoly a nettement plus d'épisodes
                if best_sibnet and len(best_sibnet) >= len(best_vidmoly) * 0.8:
                    best_server = 'sibnet'
                    best_episodes = best_sibnet
                elif best_vidmoly:
                    best_server = 'vidmoly'
                    best_episodes = best_vidmoly
                elif best_sibnet:
                    best_server = 'sibnet'
                    best_episodes = best_sibnet
                else:
                    best_server = None
                    best_episodes = []
                self.debug_print(f"{len(best_episodes)} épisodes ({best_server}), sibnet={len(best_sibnet)}, vidmoly={len(best_vidmoly)}")

                if best_episodes:
                    count = min(len(ep_names), len(best_episodes)) if ep_names else len(best_episodes)
                    for i, (vid_id, srv) in enumerate(best_episodes[:count]):
                        name = ep_names[i] if i < len(ep_names) else f"Épisode {i + 1}"
                        all_links[str(i + 1)] = (srv, vid_id, name)
                    self.debug_print(f"{len(all_links)} épisodes mappés ({best_server})")
            else:
                # Fallback : liens directs dans le JS
                self.debug_print("Pas de tableaux eps*, fallback liens directs")
                sibnet = {str(i): ('sibnet', m.group(1)) for i, m in enumerate(
                    re.finditer(r'https://video\.sibnet\.ru/shell\.php\?videoid=(\d+)', content), 1)}
                vidmoly = {str(i): ('vidmoly', m.group(1)) for i, m in enumerate(
                    re.finditer(r'https://vidmoly\.to/embed-([^.]+)\.html', content), 1)}
                source = sibnet if len(sibnet) >= len(vidmoly) and sibnet else vidmoly
                for k, (srv, vid_id) in source.items():
                    name = ep_names[int(k) - 1] if int(k) - 1 < len(ep_names) else f"Épisode {k}"
                    all_links[k] = (srv, vid_id, name)

            if all_links:
                self.debug_print(f"Total : {len(all_links)} épisodes")
            else:
                self.debug_print("Aucun épisode trouvé")
            return all_links

        except requests.RequestException as e:
            print(f"{RED}✗ Erreur récupération épisodes : {e}{RESET}")
            return {}

    # ── Résolution URL vidéo ──────────────────────────────────────────────────

    def get_video_url(self, video_data):
        try:
            video_type, video_id = video_data[0], video_data[1]
            if video_type == 'sibnet':
                return self._get_sibnet_url(video_id)
            elif video_type == 'vidmoly':
                return self._get_vidmoly_url(video_id)
            else:
                print(f"{RED}✗ Serveur inconnu : {video_type}{RESET}")
                return None
        except Exception as e:
            print(f"{RED}✗ Erreur URL vidéo : {e}{RESET}")
            return None

    def _get_sibnet_url(self, video_id):
        try:
            resp = self.session.get("https://video.sibnet.ru/shell.php", params={"videoid": video_id})
            resp.raise_for_status()
            match = re.search(r'player\.src\(\[\{src: "/v/([^/]+)/', resp.text)
            if match:
                url_mp4 = f"https://video.sibnet.ru/v/{match.group(1)}/{video_id}.mp4"
                headers = {**HEADERS_BASE, "range": "bytes=0-", "accept-encoding": "identity", "referer": "https://video.sibnet.ru/"}
                r2 = self.session.get(url_mp4, headers=headers, allow_redirects=False)
                if r2.status_code == 302:
                    return r2.headers['Location']
                self.debug_print(f"Sibnet status inattendu : {r2.status_code}")
            else:
                self.debug_print("Pattern Sibnet introuvable")
            return None
        except requests.RequestException as e:
            print(f"{RED}✗ Erreur Sibnet : {e}{RESET}")
            return None

    def _get_vidmoly_url(self, video_id):
        for domain in ['vidmoly.net', 'vidmoly.to']:
            try:
                embed_url = f"https://{domain}/embed-{video_id}.html"
                self.debug_print(f"Extraction HLS depuis {domain}...")
                headers = {'User-Agent': HEADERS_BASE['user-agent'], 'Referer': f'https://{domain}/'}
                resp = self._cached_request('get', embed_url, headers=headers)
                for pattern in [
                    r'sources:\s*\[\s*\{\s*file:\s*["\']([^"\']+\.m3u8[^"\']*)["\']',
                    r'file:\s*["\']([^"\']+\.m3u8[^"\']*)["\']',
                    r'"file"\s*:\s*"([^"]+\.m3u8[^"]*)"',
                    r'src:\s*["\']([^"\']+\.m3u8[^"\']*)["\']',
                ]:
                    m = re.search(pattern, resp.text, re.IGNORECASE | re.DOTALL)
                    if m:
                        url = m.group(1)
                        if url.startswith('//'):
                            url = 'https:' + url
                        elif not url.startswith('http'):
                            url = f"https://{url.lstrip('/')}"
                        self.debug_print("URL HLS trouvée")
                        return url
                self.debug_print(f"Pas d'HLS sur {domain}, retour embed URL")
                return embed_url
            except Exception as e:
                self.debug_print(f"Erreur {domain} : {e}")
                continue
        return f"https://vidmoly.net/embed-{video_id}.html"

    # ── Catalogue ─────────────────────────────────────────────────────────────

    def get_catalogue(self, query="", vf=False):
        try:
            url = "https://anime-sama.to/catalogue/"
            headers = {
                **HEADERS_BASE,
                "host": "anime-sama.to",
                "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
                "referer": "https://anime-sama.to/catalogue/",
                "accept-language": "fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7",
            }
            qs = {"search": query}
            if vf:
                qs["langue[]"] = "VF"

            self.debug_print(f"GET {url} | params={qs}")
            resp = self._cached_request('get', url, headers=headers, params=qs)
            self.debug_print(f"Status : {resp.status_code}")

            soup = BeautifulSoup(resp.text, 'html.parser')
            animes, urls = [], []
            for card in soup.find_all('a', href=True):
                t = card.find('h2', class_='card-title')
                if t and 'catalogue' in card['href']:
                    titre = t.text.strip()
                    if titre:
                        animes.append(titre)
                        urls.append(card['href'])

            if vf:
                urls = [u.replace("vostfr", "vf") for u in urls]

            self.debug_print(f"{len(animes)} résultat(s) : {animes}")
            return animes, urls

        except requests.RequestException as e:
            print(f"{RED}✗ Erreur catalogue : {e}{RESET}")
            return [], []


